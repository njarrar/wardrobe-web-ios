{
  "name": "wardrobe",
  "version": "2.1.0",
  "private": true,
  "description": "A local-first AI wardrobe gallery powered by Claude.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "ios:sync": "vite build && cap sync ios",
    "ios": "npm run ios:sync && cap open ios",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:migrate": "wrangler d1 migrations apply wardrobe --remote",
    "cf:upload": "node scripts/upload-to-cloudflare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@unpic/react": "^1.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "fast-png": "^8.0.0",
    "ipx": "^3.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "wrangler": "^4.142.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
