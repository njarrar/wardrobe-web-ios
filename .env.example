# Claude finds the clothes in your photos and styles outfits.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
WARDROBE_CLAUDE_MODEL=claude-opus-5

# Optional: the open model that cuts garments out of their background on this
# computer. Needs the @huggingface/transformers package (installed with npm install).
WARDROBE_CUTOUT_MODEL=onnx-community/BiRefNet_lite

# Leave these alone to keep the app on this computer only. To use it from
# your phone, set WARDROBE_HOST=0.0.0.0 and a long random WARDROBE_TOKEN.
WARDROBE_HOST=127.0.0.1
WARDROBE_TOKEN=
