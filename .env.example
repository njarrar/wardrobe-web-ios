# The AI finds the clothes in your photos and styles outfits. The easy way:
# open Settings (the gear icon) in the app, pick Claude, ChatGPT or Gemini and
# paste its key there. Keys set here work too; a key saved in the app wins.
#
# Claude:  https://console.anthropic.com/settings/keys
# ChatGPT: https://platform.openai.com/api-keys
# Gemini:  https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Which one to use until you pick in the app: claude, openai or gemini.
# WARDROBE_AI_PROVIDER=claude
# WARDROBE_CLAUDE_MODEL=claude-opus-5
# WARDROBE_OPENAI_MODEL=gpt-6.1-sol
# WARDROBE_GEMINI_MODEL=gemini-3.8-flash

# Protects your closet. Required whenever the server is reachable from other
# devices (the NAS container always is). Use a long random string, e.g.
#   openssl rand -hex 24
# Enter the same value once in the browser and in the iPhone app.
WARDROBE_TOKEN=

# Optional: the open model that cuts garments out of their background on this
# computer / NAS. Needs the @huggingface/transformers package (installed with npm install).
WARDROBE_CUTOUT_MODEL=onnx-community/BiRefNet_lite

# Running with `npm start` on a computer: leave this as 127.0.0.1 to keep the
# app on this machine only, or set 0.0.0.0 (with a token) to use it from your
# phone. The Docker container sets 0.0.0.0 and /data for you.
WARDROBE_HOST=127.0.0.1
# WARDROBE_DATA_DIR=data

# Docker / Synology only: owner of the files in ./data (run `id` over SSH).
# PUID=1026
# PGID=100
# TZ=Europe/London
