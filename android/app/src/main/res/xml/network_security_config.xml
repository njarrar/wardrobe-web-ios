<?xml version="1.0" encoding="utf-8"?>
<!-- Most people reach their wardrobe server on home Wi-Fi by its IP address
     (for example http://192.168.1.20:4173), which has no HTTPS. Android can
     only allow plain http by domain, not by IP range, so it is allowed here.
     Every request still needs the server's access token. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
